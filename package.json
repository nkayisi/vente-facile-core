{
  "name": "@vente-facile/core",
  "version": "0.7.2",
  "description": "Regles metier partagees entre le back-office web et l'application mobile Vente Facile.",
  "license": "UNLICENSED",
  "private": false,
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./receipt": {
      "types": "./dist/receipt/index.d.ts",
      "import": "./dist/receipt/index.js",
      "require": "./dist/receipt/index.cjs"
    },
    "./pos": {
      "types": "./dist/pos/index.d.ts",
      "import": "./dist/pos/index.js",
      "require": "./dist/pos/index.cjs"
    },
    "./report": {
      "types": "./dist/report/index.d.ts",
      "import": "./dist/report/index.js",
      "require": "./dist/report/index.cjs"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "type-check": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "tsup": "^8.5.0",
    "typescript": "^5.9.2",
    "vitest": "^3.2.4"
  },
  "packageManager": "pnpm@9.15.0"
}
